# Copy to .env for local development. Never commit .env.
# On Azure, set these as App Service application settings.

# Paths are relative to the repo root unless absolute.
CLASSIFY_DATA_PATH=data/tcu_classes_spring27.json
CLASSIFY_META_PATH=data/term_meta.json
CLASSIFY_SHOWCASE_PATH=data/instructors_showcase.json

